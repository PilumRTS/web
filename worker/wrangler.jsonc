{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "pilum-downloads",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "downloads.pilumrts.com",
      "custom_domain": true
    },
    {
      "pattern": "download.pilumrts.com",
      "custom_domain": true
    },
    {
      "pattern": "mail.pilumrts.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "SITE_ORIGIN": "https://pilumrts.com",
    "DOWNLOAD_ORIGIN": "https://download.pilumrts.com",
    "LEGACY_DOWNLOAD_ORIGIN": "https://downloads.pilumrts.com",
    "MAIL_ORIGIN": "https://mail.pilumrts.com",
    "EMAIL_FROM": "info@pilumrts.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pilum-downloads",
      "database_id": "94499d97-d1ca-4cb9-b56e-46354c1f3b83",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "account_id": "ec5b7df56f3a7683902b3c7a879ae340",
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
